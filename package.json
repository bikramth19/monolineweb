"scripts": {
  "dev": "npm run dev:mysql",

  "predev:mysql": "npm run db:generate:mysql",
  "dev:mysql": "dotenv -e .env.mysql -- next dev -p 3000",

  "predev:neon": "npm run db:generate:neon",
  "dev:neon": "dotenv -e .env.neon -- next dev -p 3000",

  "build": "npm run build:vercel",

  "build:vercel": "prisma generate --schema prisma/neon/schema.prisma && next build",

  "build:mysql": "npm run db:generate:mysql && next build",

  "build:neon": "npm run db:generate:neon && next build",

  "start": "next start -p 3000",

  "typecheck": "tsc --noEmit",

  "db:generate:mysql": "dotenv -e .env.mysql -- prisma generate --schema prisma/mysql/schema.prisma",

  "db:generate:neon": "dotenv -e .env.neon -- prisma generate --schema prisma/neon/schema.prisma",

  "db:push:mysql": "dotenv -e .env.mysql -- prisma db push --schema prisma/mysql/schema.prisma",

  "db:push:neon": "dotenv -e .env.neon -- prisma db push --schema prisma/neon/schema.prisma",

  "db:seed:mysql": "dotenv -e .env.mysql -- node scripts/seed.mjs",

  "db:seed:neon": "dotenv -e .env.neon -- node scripts/seed.mjs",

  "content:update:mysql": "dotenv -e .env.mysql -- node scripts/update-content.mjs",

  "content:update:neon": "dotenv -e .env.neon -- node scripts/update-content.mjs",

  "db:studio:mysql": "dotenv -e .env.mysql -- prisma studio --schema prisma/mysql/schema.prisma",

  "db:studio:neon": "dotenv -e .env.neon -- prisma studio --schema prisma/neon/schema.prisma"
}